-- Hàm tạo các nút chức năng trong Menu chuẩn giao diện mới
local function AddToggleButton(name, initialState, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.BackgroundColor3 = initialState and Color3.fromRGB(40, 160, 90) or Color3.fromRGB(45, 45, 60)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = name .. " : " .. (initialState and "[ BẬT ]" : "[ TẮT ]")
    btn.Parent = ScrollingFrame

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    local state = initialState
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(40, 160, 90) or Color3.fromRGB(45, 45, 60)
        btn.Text = name .. " : " .. (state and "[ BẬT ]" : "[ TẮT ]")
        callback(state)
    end)
end

