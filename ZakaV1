-- Hàm tạo các nút bấm chức năng chuẩn cấu trúc
local function CreateButton(name, defaultState, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 42)
    btn.BackgroundColor3 = defaultState and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(45, 45, 55)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = name .. ": " .. (defaultState and "BẬT" or "TẮT")
    btn.Parent = ContentScrolling

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    local state = defaultState
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 150, 100) or Color3.fromRGB(45, 45, 55)
        btn.Text = name .. ": " .. (state and "BẬT" or "TẮT")
        callback(state)
    end)
end

